APP_NAME=Fretado API
APP_ENV=development

SECRET_KEY=sua_chave_aqui
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_URL=https://fretado.pages.dev/#/reset-password

DATABASE_URL=postgresql://usuario:senha@localhost:5432/fretado_db

# URL base do projeto, sem /rest/v1 nem /storage/v1.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATARS_BUCKET=avatars

CORS_ALLOW_ORIGINS=https://fretado.pages.dev
CORS_ALLOW_ORIGIN_REGEX=

DRIVER_SEARCH_RADIUS_KM=50
DRIVER_LOCATION_MAX_AGE_MINUTES=5

EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_FROM=Fretado <onboarding@resend.dev>
RESEND_API_KEY=re_sua_api_key_do_resend
RESEND_API_URL=https://api.resend.com/emails

MAPBOX_ACCESS_TOKEN=SEU_TOKEN_AQUI
MAPBOX_DIRECTIONS_PROFILE=mapbox/driving-traffic
MAPBOX_BASE_URL=https://api.mapbox.com

# Cadastro por marca/modelo/versão exige acesso PJ ao catálogo da Carpédia.
# O provedor considera o saldo aplicável (grátis/pago); o backend não bloqueia pelo saldo legado.
CARPEDIA_BASE_URL=https://www.carpedia.com.br/api/v2
CARPEDIA_API_KEY=cpk_sua_chave_aqui
CARPEDIA_TIMEOUT_SECONDS=10
CARPEDIA_CACHE_TTL_SECONDS=3600

FIREBASE_CREDENTIALS_JSON= 

